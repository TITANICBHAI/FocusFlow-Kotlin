<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusFlow" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/focusflow_indigo</item>
        <item name="android:navigationBarColor">@color/focusflow_background</item>
        <item name="android:statusBarColor">@color/focusflow_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!--
      Native Splash Theme
      Mirrors archived Expo splash configuration:
      backgroundColor: #6366f1, resizeMode: contain, image: splash.png
      Prevents white or black flash on cold launch before Compose initializes.
    -->
    <style name="Theme.FocusFlow.Splash" parent="Theme.FocusFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/focusflow_indigo</item>
        <item name="android:navigationBarColor">@color/focusflow_indigo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>