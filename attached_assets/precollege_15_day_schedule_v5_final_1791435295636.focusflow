    {
      "id": "precollege15-d01-college-skill",
      "title": "Day 1: Canva / presentation skill",
      "description": "Canva: start the official beginner course 'Canva essentials' (https://www.canva.com/design-school/courses/canva-essentials/). Do the opening/navigation lesson(s), then spend the rest of the session clicking through the editor yourself. Goal: know where projects, templates and core tools are.\nAt about 20 min, stand/walk for 60 sec and reset your shoulders/neck before continuing.",
      "startTime": "2026-10-08T10:30:00Z",
      "endTime": "2026-10-08T11:10:00Z",
      "durationMinutes": 40,
      "status": "scheduled",
