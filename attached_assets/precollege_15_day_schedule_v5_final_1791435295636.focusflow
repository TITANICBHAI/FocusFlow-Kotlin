      "updatedAt": "2026-10-08T00:20:00Z"
    },
    {
      "id": "precollege15-d10-evening-recall",
      "title": "Day 10: Evening recall",
      "description": "Closed-book evening recall: retrieve today's nursing/science material first, then review only what you missed. After recall, stand/walk for 2–3 min: 5 relaxed shoulder rolls, 5 chin tucks, and a few easy steps. Avoid short-form scrolling immediately afterward. Protect the last part of the night for winding down and keeping tomorrow's 07:00 wake time realistic.",
      "startTime": "2026-10-17T15:00:00Z",
      "endTime": "2026-10-17T15:20:00Z",
      "durationMinutes": 20,
      "status": "scheduled",
