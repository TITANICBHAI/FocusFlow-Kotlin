    {
      "id": "precollege15-d13-walk",
      "title": "Day 13: Outdoor walk",
      "description": "20–30 min low-stimulation outdoor walk. Keep it easy on strength days and comfortable-to-brisk on conditioning days only if you feel good. Every 10 min, spend about 30 sec changing posture: stand tall without forcing, relax shoulders, move the neck gently, and keep breathing normally. Use this block to get away from screens and let your brain decompress; do not turn it into another hard workout.",
      "startTime": "2026-10-20T11:30:00Z",
      "endTime": "2026-10-20T12:00:00Z",
      "durationMinutes": 30,
      "status": "scheduled",
