modules = ["nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Push to GitHub"

[[workflows.workflow]]
name = "Push to GitHub"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/push-to-github.sh"

[[workflows.workflow]]
name = "Run Android unit tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-unit.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 22876
externalPort = 80
